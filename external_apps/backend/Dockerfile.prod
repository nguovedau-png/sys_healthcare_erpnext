FROM node:22-alpine

WORKDIR /app

# Install PM2 globally
RUN npm install -g pm2

# Copy package files and the workspace lockfile used by CI
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma/

# Install the exact dependency graph; scripts are disabled until Prisma is generated explicitly.
RUN corepack enable && corepack prepare pnpm@11.0.0 --activate
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy source code
COPY . .

# Generate Prisma Client and compile the application
RUN pnpm exec prisma generate
RUN pnpm run build

# Re-install only production dependencies (optional, but good for size)
# RUN npm prune --production # Commented out to ensure devDeps typically needed for some runtime tasks if any remain available, but standard is prune.

EXPOSE 3000 3001 3002

# Start PM2
CMD ["pm2-runtime", "start", "ecosystem.config.cjs"]
