# Server
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=hd_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me
JWT_REFRESH_EXPIRES_IN=7d

# Two Factor Auth (TOTP)
TOTP_APP_NAME=HD_Template_App

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM="Support <support@example.com>"

# Firebase
FIREBASE_CREDENTIAL_PATH=./firebase-key.json

# Admin Seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin@123

# ERPNext integration (server-only; never expose as NEXT_PUBLIC_*)
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_TIMEOUT_MS=5000
ERPNEXT_MAX_RETRIES=3
