# ==========================================
# Web Public - Environment Variables Template
# Copy this file to .env.local and fill in the values
# ==========================================

# API Configuration
# Backend API URL (NestJS API Gateway)
NEXT_PUBLIC_API_URL=http://localhost:3000

# WebSocket URL (for real-time chat, notifications)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Application Settings
NEXT_PUBLIC_APP_NAME=Healthcare System
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development

# Authentication
# JWT Secret (must match backend JWT_SECRET)
NEXT_PUBLIC_JWT_SECRET=supersecret
NEXT_PUBLIC_TOKEN_EXPIRY=24h

# Zoom Integration (for telemedicine)
# Get from: https://marketplace.zoom.us/
NEXT_PUBLIC_ZOOM_API_KEY=
NEXT_PUBLIC_ZOOM_API_SECRET_KEY=
NEXT_PUBLIC_ZOOM_SDK_KEY=
NEXT_PUBLIC_ZOOM_SDK_SECRET=

# Google Maps API (for location services)
# Get from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics (Optional)
# Google Analytics Tracking ID
NEXT_PUBLIC_GA_TRACKING_ID=
# Google Tag Manager ID
NEXT_PUBLIC_GTM_ID=

# File Upload Settings
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Feature Toggles (true/false)
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_TELEMEDICINE=true
NEXT_PUBLIC_ENABLE_BOOKING=true
NEXT_PUBLIC_ENABLE_ECOMMERCE=true
NEXT_PUBLIC_ENABLE_COMMUNITY=true
NEXT_PUBLIC_ENABLE_EDUCATION=true

# Payment Gateway (Optional - add when integrating)
# Stripe: https://stripe.com
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# PayPal: https://developer.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Email Service (Optional)
# Services: sendgrid, mailgun, ses
NEXT_PUBLIC_EMAIL_SERVICE=
NEXT_PUBLIC_EMAIL_API_KEY=

# SMS Service (Optional)
# Services: twilio, vonage
NEXT_PUBLIC_SMS_API_KEY=
NEXT_PUBLIC_SMS_SENDER_ID=HEALTHCARE

# CDN / Cloud Storage (Optional)
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_S3_BUCKET=
NEXT_PUBLIC_S3_REGION=

# Logging & Debug
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false

# Rate Limiting
NEXT_PUBLIC_API_RATE_LIMIT=100
NEXT_PUBLIC_API_RATE_LIMIT_WINDOW=60000

# Cache Settings
NEXT_PUBLIC_CACHE_TTL=3600
NEXT_PUBLIC_ENABLE_CACHE=true
