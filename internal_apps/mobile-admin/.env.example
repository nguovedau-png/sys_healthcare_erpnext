# Example environment variables for the mobile app

# Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:1337

# Firebase configuration (for client-side Firebase if needed)
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123def456

# For development, you can use the local IP address
# EXPO_PUBLIC_API_URL=http://192.168.1.8:1337