{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "passenger": "echo \"export default 'passenger';\" > mode.js && npx react-native run-ios --simulator='iPhone 16'",
    "delivery": "echo \"export default 'delivery';\" > mode.js && npx react-native run-ios --simulator='iPhone 15'",
    "both": "echo \"export default null;\" > mode.js"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.0",
    "@react-native-community/geolocation": "^3.0.6",
    "axios": "^1.4.0",
    "lodash": "^4.17.21",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-background-fetch": "^4.2.8",
    "react-native-background-geolocation": "^4.19.3",
    "react-native-maps": "^1.18.0",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "^13.0.0",
    "@react-native-community/cli-platform-android": "^13.0.0",
    "@react-native-community/cli-platform-ios": "^13.0.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "^0.83.1",
    "@react-native/metro-config": "^0.83.1",
    "@tsconfig/react-native": "^2.0.2",
    "@types/jest": "^29.2.1",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.73.9",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4"
  },
  "jest": {
    "preset": "react-native"
  }
}