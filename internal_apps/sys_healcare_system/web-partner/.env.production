# ==========================================
# Web Public - Production Environment
# ==========================================

# API Configuration
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com

# Application
NEXT_PUBLIC_APP_NAME=Healthcare System
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_ENV=production

# Authentication
NEXT_PUBLIC_JWT_SECRET=your-super-secret-jwt-key-change-in-production
NEXT_PUBLIC_TOKEN_EXPIRY=24h

# Zoom Integration
NEXT_PUBLIC_ZOOM_API_KEY=your_zoom_api_key
NEXT_PUBLIC_ZOOM_API_SECRET_KEY=your_zoom_api_secret
NEXT_PUBLIC_ZOOM_SDK_KEY=your_zoom_sdk_key
NEXT_PUBLIC_ZOOM_SDK_SECRET=your_zoom_sdk_secret

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Analytics
NEXT_PUBLIC_GA_TRACKING_ID=your_ga_tracking_id
NEXT_PUBLIC_GTM_ID=your_gtm_id

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Features Toggle
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_TELEMEDICINE=true
NEXT_PUBLIC_ENABLE_BOOKING=true
NEXT_PUBLIC_ENABLE_ECOMMERCE=true
NEXT_PUBLIC_ENABLE_COMMUNITY=true
NEXT_PUBLIC_ENABLE_EDUCATION=true

# Payment Gateway
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your_stripe_public_key
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# Email Service
NEXT_PUBLIC_EMAIL_SERVICE=sendgrid
NEXT_PUBLIC_EMAIL_API_KEY=your_email_api_key

# SMS Service
NEXT_PUBLIC_SMS_API_KEY=your_sms_api_key
NEXT_PUBLIC_SMS_SENDER_ID=HEALTHCARE

# CDN / Storage
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com
NEXT_PUBLIC_S3_BUCKET=your-bucket-name
NEXT_PUBLIC_S3_REGION=us-east-1

# Logging
NEXT_PUBLIC_LOG_LEVEL=error
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# Rate Limiting
NEXT_PUBLIC_API_RATE_LIMIT=100
NEXT_PUBLIC_API_RATE_LIMIT_WINDOW=60000

# Cache
NEXT_PUBLIC_CACHE_TTL=3600
NEXT_PUBLIC_ENABLE_CACHE=true
