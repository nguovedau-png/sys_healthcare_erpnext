./start-dev.sh

# Complete setup + start (RECOMMENDED)
npm run dev:full

# Setup without starting
npm run dev:setup

# Setup + start services
npm run dev:start

# Just start services (if already setup)
npm run start:dev

# Docker management
npm run docker:dev           # Start infrastructure
npm run docker:dev:down      # Stop infrastructure
npm run docker:dev:logs      # View logs

# Database
npm run migrate:all          # Run all migrations
npm run seed                 # Seed database

