{
  "name": "cross-platform-client-tamagui",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "yarn@4.5.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "upgrade:tamagui": "yarn up '*tamagui*'@latest '@tamagui/*'@latest",
    "upgrade:tamagui:canary": "yarn up '*tamagui*'@canary '@tamagui/*'@canary",
    "check:tamagui": "tamagui check",
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "biome:dev": "biome check --write . && tsc --noEmit",
    "biome:ci": "biome check . && tsc --noEmit",
    "test:notifications": "node test-notifications.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@react-navigation/native": "^7.1.6",
    "@tamagui/config": "^1.128.1",
    "@tamagui/lucide-icons": "^1.128.1",
    "@tamagui/toast": "^1.128.1",
    "agora-react-native-rtm": "^1.5.1",
    "agora-rn-uikit": "^3.3.0",
    "babel-preset-expo": "~13.0.0",
    "burnt": "^0.12.2",
    "expo": "53.0.12",
    "expo-build-properties": "~0.14.6",
    "expo-clipboard": "^8.0.6",
    "expo-constants": "~17.0.8",
    "expo-device": "~6.0.2",
    "expo-font": "~13.3.1",
    "expo-linking": "~7.1.5",
    "expo-notifications": "~0.30.0",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.9",
    "expo-web-browser": "~14.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.58.1",
    "react-native": "0.79.4",
    "react-native-agora": "^3.5.3",
    "react-native-gifted-chat": "^2.8.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "react-native-webview": "^13.16.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-socket.io": "^1.4.0",
    "socket.io-client": "^4.8.1",
    "tamagui": "^1.128.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@biomejs/biome": "^1.9.4",
    "@expo/metro-config": "~0.20.0",
    "@expo/metro-runtime": "~5.0.4",
    "@tamagui/babel-plugin": "^1.128.1",
    "@tamagui/cli": "^1.128.1",
    "@tamagui/metro-plugin": "^1.128.1",
    "@testing-library/jest-native": "^5.4.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.73.0",
    "@types/redux-socket.io": "^1",
    "jest": "^30.1.3",
    "jest-expo": "^54.0.11",
    "ts-jest": "^29.4.1",
    "typescript": "~5.8.3"
  },
  "resolutions": {
