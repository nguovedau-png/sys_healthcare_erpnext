# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_microservices?schema=public"

# Message Broker
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Authentication
JWT_SECRET="supersecret"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
RP_ID="localhost"
EXPECTED_ORIGIN="http://localhost:3000"
# Comma-separated browser origins allowed by the API gateway in production.
FRONTEND_ORIGINS="http://localhost:3000"
# Optional comma-separated CSP sources; defaults are safe local-development values.
CSP_IMAGE_SOURCES="'self',data:,https://images.unsplash.com,https://picsum.photos"
CSP_CONNECT_SOURCES="'self',http://localhost:3000,http://localhost:5050"

# ElasticSearch
ELASTICSEARCH_URL="http://localhost:9200"

# Service Ports (Optional overrides)
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
# Bot Configurations
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
SLACK_WEBHOOK_URL="your_slack_webhook_url"
FACEBOOK_PAGE_ACCESS_TOKEN="your_facebook_page_access_token"
FACEBOOK_PAGE_ID="your_facebook_page_id"
