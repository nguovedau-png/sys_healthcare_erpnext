{
  "name": "saas-microservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:prod": "docker-compose up -d --build --parallel=false",
    "docker:prod:down": "docker-compose down",
    "migrate:auth": "npx prisma migrate dev --schema=apps/auth-service/prisma/schema.prisma",
    "migrate:user": "npx prisma migrate dev --schema=apps/user-service/prisma/schema.prisma",
    "migrate:all": "./migrate_all.sh",
    "seed": "npx prisma db seed --schema=apps/user-service/prisma/schema.prisma",
    "seed:user": "bash seed-user-service.sh",
    "seed:force": "npx prisma migrate reset --schema=apps/user-service/prisma/schema.prisma --force && npx prisma db seed --schema=apps/user-service/prisma/schema.prisma",
    "seed:all": "bash seed-all-and-test.sh",
    "verify:data": "ts-node -r tsconfig-paths/register apps/user-service/prisma/verify-data.ts",
    "auto:setup": "bash auto-seed.sh",
    "test:api": "curl -s http://localhost:3006/users | jq .",
    "prisma:generate": "bash scripts/generate-prisma-clients.sh",
    "dev:setup": "npm run docker:dev && npm install && npm run migrate:all && npm run seed",
    "dev:start": "npm run dev:setup && npm run start:dev",
    "dev:full": "bash start-dev.sh",
    "setup:full": "bash setup-dev.sh",
    "start:all": "bash start-all-services.sh"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/elasticsearch": "^10.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.20",
    "@prisma/client": "^5.18.0",
    "@simplewebauthn/server": "^10.0.1",
    "@types/axios": "^0.14.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "cache-manager": "^7.2.7",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "multer": "1.4.5-lts.1",
    "nest-winston": "^1.10.2",
    "node-telegram-bot-api": "^0.67.0",
    "opossum": "^9.0.0",
    "prisma": "^5.18.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.3.1",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/opossum": "^8.1.9",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register --compiler-options {\"module\":\"CommonJS\"} apps/user-service/prisma/seed.ts"
  }
}
