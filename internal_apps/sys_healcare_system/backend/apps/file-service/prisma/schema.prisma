generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-file-service"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id        Int      @id @default(autoincrement())
  filename  String
  path          String
  thumbnailPath String?
  mimetype      String
  size      Int
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
