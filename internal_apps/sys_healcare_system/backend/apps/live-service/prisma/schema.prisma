generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-live-service"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LiveProvider {
  WEBRTC
  AGORA
  ZOOM
  JITSI
  OTHER
}

model Livestream {
  id             Int          @id @default(autoincrement())
  title          String
  description    String?
  provider       LiveProvider @default(WEBRTC)
  providerConfig Json? // Stores provider-specific data (meetingId, tokens, etc.)
  streamKey      String?
  serverUrl      String?
  isStreaming    Boolean      @default(false)
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int? // In minutes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  viewers        LiveViewer[]
}

model LiveViewer {
  id           Int        @id @default(autoincrement())
  livestreamId Int
  userId       String // External user ID
  userName     String
  joinedAt     DateTime   @default(now())
  leftAt       DateTime?
  livestream   Livestream @relation(fields: [livestreamId], references: [id])
}

model LiveChatMessage {
  id           Int      @id @default(autoincrement())
  livestreamId Int
  userName     String
  userRole     String?
  content      String
  createdAt    DateTime @default(now())
}
