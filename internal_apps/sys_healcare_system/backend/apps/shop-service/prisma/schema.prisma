generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-shop-service"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  title    String
  image    String?
  icon     String?
  products Product[]
}

model Product {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  title         String
  image         String?
  price         Int
  originalPrice Int?
  discount      Int?
  isNew         Boolean   @default(false)
  isHot         Boolean   @default(false)
  isBestSelling Boolean   @default(false)
  categoryId    Int?
  category      Category? @relation(fields: [categoryId], references: [id])
  createdAt     DateTime  @default(now())
}
