generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-erp-service"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ErpKey {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  userId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([userId])
}

model InventoryItem {
  id           Int      @id @default(autoincrement())
  name         String
  sku          String   @unique
  category     String?
  manufacturer String?
  price        Float
  stock        Int      @default(0)
  minStock     Int      @default(0)
  expiry       String?
  status       String   @default("In Stock")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sku])
  @@index([category])
}

model SyncOperation {
  id             String   @id @default(cuid())
  tenantId       String
  facilityId     String
  sourceSystem   String
  sourceId       String
  idempotencyKey String
  doctype        String
  documentName   String?
  requestHash    String
  status         String   @default("PENDING")
  attemptCount   Int      @default(0)
  nextAttemptAt  DateTime?
  lastErrorCode  String?
  lastError      String?
  requestSummary Json?
  responseData   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  @@unique([tenantId, sourceSystem, sourceId, idempotencyKey])
  @@index([tenantId, facilityId, status, nextAttemptAt])
  @@index([doctype, sourceId])
}

model DrugReference {
  id                Int      @id @default(autoincrement())
  name              String
  activeIngredient  String
  indications       String?
  contraindications String?
  dosage            String?
  sideEffects       String?
  interactions      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
